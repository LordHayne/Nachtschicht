+  // Nightforge: the frame rate goes to the log (Nightforge's wine.log) every 10 s for the first two
+  // minutes, then every minute, the way Nightforge's Vulkan layer does it. Nightforge learns from
+  // it which frame limit a game holds on this Mac.
+  void LogFrameRate() {
+    double now = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    if (frame_log_started_ == 0)
+      frame_log_started_ = frame_log_period_start_ = frame_log_last_ = now;
+    frame_log_slowest_ = std::max(frame_log_slowest_, now - frame_log_last_);
+    frame_log_last_ = now;
+    frame_log_frames_++;
+    double period = now - frame_log_started_ < 120 ? 10 : 60;
+    double seconds = now - frame_log_period_start_;
+    if (seconds < period)
+      return;
+    Logger::info(std::format("[nightforge-dxmt] {}: {:.1f} FPS over {:.0f} s, frames {:.1f} ms on average, slowest {:.0f} ms",
+                             env::getExeBaseName(), frame_log_frames_ / seconds, seconds,
+                             seconds * 1000 / frame_log_frames_, frame_log_slowest_ * 1000));
+    frame_log_period_start_ = now;
+    frame_log_frames_ = 0;
+    frame_log_slowest_ = 0;
+  }
+
